{
  "name": "opening_situation",
  "properties": {
    "situation": { "type": "string", "minLength": 1, "maxLength": 800 },
    "place": { "$bind": "place" },
    "weather": {
      "type": "string",
      "minLength": 1,
      "maxLength": { "$bind": "locationMax" },
      "pattern": "[^\\r\\n]+"
    },
    "reputation": {
      "type": "string",
      "minLength": 1,
      "maxLength": { "$bind": "locationMax" },
      "pattern": "[^\\r\\n]+"
    }
  }
}
