{"nodes": [{"id": "readme_awesome_games", "label": "Awesome Games", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One Next.js app and one origin. Each game is a top-level directory so games stay isolated while sharing a single deployable app."}, {"id": "readme_dashboard", "label": "Dashboard", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The game grid reads the generated catalog rather than the filesystem, so listing games does not scan directories at runtime. dashboard/ is not a game."}, {"id": "readme_app", "label": "App URL Shell", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app/ is only the URL shell: root layout, /, /dashboard, and generated /game/... pages. / redirects to /dashboard."}, {"id": "readme_leaders", "label": "Leaders Game", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leaders owns its rules, lobby, and UI. Lobby and match rules stay in the Leaders connection module rather than in the shared mesh."}, {"id": "readme_common", "label": "common/", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared code lives in common/, including P2P, so games share infrastructure without importing each other's rules."}, {"id": "readme_public", "label": "public/", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next serves static files only from public/."}, {"id": "readme_scripts", "label": "scripts/", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_manifest", "label": "Game Manifest", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A game is any immediate child directory whose manifest.json has kind game. The directory name is the URL slug, which keeps routing and catalog identity the same string."}, {"id": "readme_sync_game_routes", "label": "sync-game-routes.mjs", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dev and build run this script first so routes cannot drift from game pages. It writes common/games.generated.ts from each manifest, writes one-line re-exports in app/game/, and deletes shims whose source page is gone."}, {"id": "readme_games_generated", "label": "games.generated.ts", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated from each game manifest so the dashboard can list games without reading the filesystem."}, {"id": "readme_create_game", "label": "create-game", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The slug is lowercase letters, digits, and single hyphens. The command writes manifest.json, paths.ts, and app/page.tsx, then syncs the route. It does not edit the dashboard; refresh /dashboard to see the new card."}, {"id": "readme_routable_screens", "label": "Routable Game Screens", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screens live in slug/app/**/page.tsx and are mirrored under /game/slug/ so each game keeps its own pages while the app shell owns the public URL."}, {"id": "readme_leaders_routes", "label": "Leaders Routes", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_legacy_redirects", "label": "Legacy Leaders Redirects", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/play, /lobby, and /room/... redirect to the Leaders paths so older URLs keep working after the /game/leaders layout."}, {"id": "readme_open_mesh", "label": "openMesh", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The caller names the app id, room code, and channel names and handles the handshake, so the shared mesh stays game-agnostic. openMesh joins a room, waits for a signaling relay, watches ICE, and exposes one request channel and one broadcast channel."}, {"id": "readme_trystero", "label": "Trystero", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_room_connection", "label": "room-connection.ts", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seat, chat, ready, and game commands stay in Leaders. The module calls openMesh with app id app.dirigeant and channels lobby-intent and lobby-feed."}], "edges": [{"source": "readme_awesome_games", "target": "readme_dashboard", "relation": "refer