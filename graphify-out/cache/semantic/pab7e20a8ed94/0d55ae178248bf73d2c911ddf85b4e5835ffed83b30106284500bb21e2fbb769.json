{"nodes": [{"id": "public_leaders_characters_protector", "label": "Protector portrait", "file_type": "image", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single forward-facing character on a plain black background, composed as an isolated portrait rather than a scene."}, {"id": "public_leaders_characters_protector_protector", "label": "Protector", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The filename names this figure Protector. The pictured body is a hulking living tree with seasonal growth and luminous marks on flanking wood, a nature-guardian design. No game statistics, weapons, or interface text are visible."}, {"id": "public_leaders_characters_protector_bark_torso", "label": "Bulbous bark torso", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The oversized dark-brown trunk, with bark grain and a jagged lower edge, is the creature's body and gives it a stationary, guarding mass."}, {"id": "public_leaders_characters_protector_autumn_leaf_cascade", "label": "Autumn leaf cascade", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lobed leaves spill down the chest from pink-red through orange to yellow-green. The fall color sits on the same body as the pink blossoms, so the figure carries more than one season at once. Species is unlabeled."}, {"id": "public_leaders_characters_protector_blossom_crown", "label": "Pink blossom crown", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A twisted branch rises from the top and ends in a small pink-flowering tree. The shape matches a cherry blossom, though the species is not labeled. The living sapling marks the trunk as still growing."}, {"id": "public_leaders_characters_protector_orange_avian_visage", "label": "Orange avian visage", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yellow eyes, an orange beak, feathery cheeks, and a long orange beard sit on the lower front of the trunk and give the figure a forward gaze."}, {"id": "public_leaders_characters_protector_wooden_side_plates", "label": "Wooden side plates", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tall wood slabs flank the body and widen the silhouette into a barrier. The viewer's right plate shows concentric growth rings. They are not clearly gripped as handheld shields."}, {"id": "public_leaders_characters_protector_glowing_green_sigils", "label": "Glowing green sigils", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lime-green luminous curved marks sit on both side plates. The glow is the only light effect and suggests a ward, but no inscription or rule text is readable."}, {"id": "public_leaders_characters_protector_vine_tendrils", "label": "Curling green tendrils", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin bright-green shoots curl up from the upper sides, new growth on the same body as the older bark."}, {"id": "public_leaders_characters_protector_pink_blossom_cluster", "label": "Pink blossom cluster", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A clump of pink flowers grows on the figure's left shoulder, separate from the crown tree."}, {"id": "public_leaders_characters_protector_pale_bark_marks", "label": "Pale marks on lower bark", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several small cream ovals are visible on the lower trunk. Whether they are shelf fungi, lichen, or wood knots is not settled by the drawing."}, {"id": "public_leaders_characters_protector_forest_guardian", "label": "Forest guardian", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Living wood, blossoms, autumn leaves, and luminous flank marks together present a protector of nature. This is a reading of the design, not a title written on the image."}, {"id": "public_leaders_characters_protector_leader_character", "label": "Leader character", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The asset path is leaders/characters, so the portrait is filed as a leader. The image shows one figure and no roster or title text."}, {"id": "public_leaders_characters_protector_protective_bulwark", "label": "Protective bulwark", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The side plates read as armor or bulwarks because they flank the torso. Nothing shows them held or swung as weapons."}, {"id": "public_leaders_characters_protector_nested_bird", "label": "Nested bird", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The beaked face may be a separate bird set into the trunk rather than the tree's own face. No bird body distinct from the orange beard is shown."}, {"id": "public_leaders_characters_protector_shelf_fungi", "label": "Shelf fungi", "file_type": "concept", "source_file": "public/leaders/characters/protector.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pale lower-bark ovals may be shelf fungi. Lichen and wood knots remain equally plausible."}], "edges": [{"source": "public_leaders_characters_protector", "target": "public_leaders_characters_protector_protector", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "public/leaders/characters/protector.png", "source_location": null, "weight": 1.0}, {"source": "public_leaders_characters_protector", "target": "public_leaders_characters_protector_bark_torso", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/leaders/characters/protector.png", "source_location": null, "weight": 1.0}, {"source": "public_leaders_characters_protector", "target": "public_leaders_characters_protector_autumn_leaf_cascade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/leaders/characters/protector.png", "source_location": null, "weight": 1.0}, {"source": "public_leaders_characters_protector",